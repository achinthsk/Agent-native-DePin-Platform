# Environment variables for adapters.
# Copy to `.env` and fill in. Never commit `.env`.

# Ethereum HTTPS RPC endpoint used by adapters/glow_adapter.py for eth_call
# against Glow MinerPoolAndGCA / GLW. Public endpoints work; a keyed endpoint
# (Alchemy/Infura/etc.) is more reliable.
ETH_RPC_URL=https://eth.drpc.org

# Optional override for the public GCA backend (no key required).
GCA_API_BASE=http://95.217.194.59:35015

# RealT community API (public; Cloudflare may rate-limit).
REALT_API_BASE=https://api.realtoken.community

# Public RealToken rent tracker (weekly master-rent history).
REALT_RENT_TRACKER_BASE=https://ehpst.duckdns.org/realt_rent_tracker

# Gnosis HTTPS RPC for RealT token eth_call enrichment.
GNOSIS_RPC_URL=https://rpc.gnosischain.com
